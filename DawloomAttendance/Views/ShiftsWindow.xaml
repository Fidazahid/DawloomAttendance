<Window x:Class="DawloomAttendance.Views.ShiftsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shift Templates" Height="420" Width="900"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="AddButton" Content="Add" Width="80" Height="30" Margin="0,0,8,0" Click="AddButton_Click" />
            <Button x:Name="DeleteButton" Content="Delete" Width="80" Height="30" Margin="0,0,8,0" Click="DeleteButton_Click" />
            <Button x:Name="SaveButton" Content="Save All" Width="90" Height="30" Margin="0,0,8,0" Click="SaveButton_Click" />
            <Button x:Name="RefreshButton" Content="Refresh" Width="80" Height="30" Click="RefreshButton_Click" />
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
                <DataGridTextColumn Header="Start (HH:mm)" Binding="{Binding StartTime}" Width="100" />
                <DataGridTextColumn Header="End (HH:mm)" Binding="{Binding EndTime}" Width="100" />
                <DataGridTextColumn Header="Grace (min)" Binding="{Binding GraceMinutes}" Width="90" />
                <DataGridTemplateColumn Header="Weekend (days off)" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,0">
                                <CheckBox Content="Sun" Margin="3,0" VerticalAlignment="Center" IsChecked="{Binding WeekendSun, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Content="Mon" Margin="3,0" VerticalAlignment="Center" IsChecked="{Binding WeekendMon, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Content="Tue" Margin="3,0" VerticalAlignment="Center" IsChecked="{Binding WeekendTue, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Content="Wed" Margin="3,0" VerticalAlignment="Center" IsChecked="{Binding WeekendWed, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Content="Thu" Margin="3,0" VerticalAlignment="Center" IsChecked="{Binding WeekendThu, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Content="Fri" Margin="3,0" VerticalAlignment="Center" IsChecked="{Binding WeekendFri, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Content="Sat" Margin="3,0" VerticalAlignment="Center" IsChecked="{Binding WeekendSat, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridCheckBoxColumn Header="Active" Binding="{Binding Active}" Width="55" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock VerticalAlignment="Center" Foreground="Gray"
                       Text="Tick the weekly day(s) off for this shift (e.g. Sun, or Fri + Sun)." />
            <Button Content="Close" Width="90" Height="28" HorizontalAlignment="Right" Margin="20,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
