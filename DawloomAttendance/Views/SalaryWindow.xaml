<UserControl x:Class="DawloomAttendance.Views.SalaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Generate a month -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Salary" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0" />
            <TextBlock Text="Generate for" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="MonthCombo" Width="110" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="YearCombo" Width="80" VerticalAlignment="Center" Margin="0,0,10,0" />
            <CheckBox x:Name="OvertimeCheck" Content="Overtime" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0"
                      Checked="Options_Changed" Unchecked="Options_Changed"
                      ToolTip="Add overtime pay to the slip. Unchecked = overtime not paid." />
            <CheckBox x:Name="DeductionCheck" Content="Deduction" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0"
                      Checked="Options_Changed" Unchecked="Options_Changed"
                      ToolTip="Deduct pay when attendance is below 100% (absences/unpaid leave/lates). Unchecked = full salary paid." />
            <CheckBox x:Name="AllowAbove100Check" Content="Allow % above 100%" VerticalAlignment="Center" Margin="0,0,10,0"
                      Checked="AllowAbove100_Changed" Unchecked="AllowAbove100_Changed"
                      ToolTip="Display only — never changes pay. Off: attendance % is capped at 100% on the slip. On: extra hours can show higher. Shared with the Reports screen and emailed reports." />
            <Button x:Name="GenerateButton" Content="Generate" Width="90" Height="30" Margin="0,0,8,0" Click="GenerateButton_Click" />
            <Button x:Name="RefreshButton" Content="Refresh" Width="80" Height="30" Click="RefreshButton_Click" />
        </StackPanel>

        <!-- Generated months -->
        <DataGrid Grid.Row="1" x:Name="BatchGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single" SelectionChanged="BatchGrid_SelectionChanged"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Month" Binding="{Binding MonthYear}" Width="140" />
                <DataGridTextColumn Header="Generated" Binding="{Binding GeneratedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="140" />
                <DataGridTextColumn Header="Auto-send" Binding="{Binding ScheduleEnabled}" Width="80" />
                <DataGridTextColumn Header="On date" Binding="{Binding ScheduleDate, StringFormat=yyyy-MM-dd}" Width="110" />
                <DataGridTextColumn Header="Sent" Binding="{Binding SentAt, StringFormat=yyyy-MM-dd HH:mm}" Width="140" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Actions for the selected month -->
        <Border Grid.Row="2" BorderBrush="#FFCCCCCC" BorderThickness="1" Padding="8" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="RegenButton" Content="Re-generate PDF" Width="130" Height="28" Margin="0,0,8,0" Click="RegenButton_Click" />
                <TextBlock Text="Send to:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="RecipientCombo" Width="170" Height="26" VerticalAlignment="Center" Margin="0,0,8,0"
                          DisplayMemberPath="Display"
                          ToolTip="Choose all employees or one person to email the slip to." />
                <Button x:Name="SendButton" Content="Send now (email)" Width="130" Height="28" Margin="0,0,16,0" Click="SendButton_Click"
                        ToolTip="Email the selected recipient their slip. Interns (no salary) are skipped." />
                <TextBlock Text="Auto-send on:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <DatePicker x:Name="SchedDate" Width="130" VerticalAlignment="Center" Margin="0,0,8,0" />
                <CheckBox x:Name="SchedEnabled" Content="Enabled" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button x:Name="SaveScheduleButton" Content="Save schedule" Width="110" Height="28" Click="SaveScheduleButton_Click" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" x:Name="StatusText" Foreground="Gray" Margin="0,8,0,0" />
    </Grid>
</UserControl>
