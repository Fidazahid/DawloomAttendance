<Window x:Class="DawloomAttendance.Views.PunchEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Punches" Height="460" Width="460"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderText" Margin="0,0,0,10" FontWeight="SemiBold" />

        <DataGrid Grid.Row="1" x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="100" IsReadOnly="True" />
                <DataGridComboBoxColumn Header="Type" x:Name="TypeColumn" Width="140"
                                        SelectedValueBinding="{Binding AttState}"
                                        SelectedValuePath="Value" DisplayMemberPath="Label" />
                <DataGridTextColumn Header="Verify" Binding="{Binding VerifyMethodLabel}" Width="90" IsReadOnly="True" />
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="80" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="DeleteButton" Content="Delete" Width="80" Height="28" Margin="0,0,8,0" Click="Delete_Click"
                    ToolTip="Delete the selected duplicate punch." />
            <TextBlock VerticalAlignment="Center" Foreground="Gray"
                       Text="Delete a duplicate, or switch its Type (Check-In/Check-Out)." />
            <Button Content="Save" Width="80" Height="28" HorizontalAlignment="Right" Margin="20,0,8,0"
                    Click="Save_Click" IsDefault="True" />
            <Button Content="Close" Width="80" Height="28" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
