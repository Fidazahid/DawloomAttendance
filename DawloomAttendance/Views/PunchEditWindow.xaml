<Window x:Class="DawloomAttendance.Views.PunchEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Punches" Height="500" Width="680" MinWidth="560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderText" Margin="0,0,0,10" FontWeight="SemiBold" />

        <DataGrid Grid.Row="1" x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="100" IsReadOnly="True" />
                <DataGridComboBoxColumn Header="Type" x:Name="TypeColumn" Width="140"
                                        SelectedValueBinding="{Binding AttState}"
                                        SelectedValuePath="Value" DisplayMemberPath="Label" />
                <DataGridTextColumn Header="Verify" Binding="{Binding VerifyMethodLabel}" Width="90" IsReadOnly="True" />
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="80" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Add a missed punch (e.g. a forgotten check-out) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="Add punch —  Time:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="NewTimeBox" Width="70" Text="18:00" VerticalAlignment="Center" ToolTip="HH:mm (24-hour)" />
            <TextBlock Text="Type:" VerticalAlignment="Center" Margin="10,0,6,0" />
            <ComboBox x:Name="NewTypeBox" Width="120" VerticalAlignment="Center">
                <ComboBoxItem Content="Check-In" Tag="0" />
                <ComboBoxItem Content="Check-Out" Tag="1" IsSelected="True" />
            </ComboBox>
            <Button Content="Add" Width="70" Height="26" Margin="10,0,0,0" Click="Add_Click" />
        </StackPanel>

        <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="True">
            <Button x:Name="DeleteButton" DockPanel.Dock="Left" Content="Delete" Width="80" Height="28" Margin="0,0,8,0"
                    Click="Delete_Click" ToolTip="Delete the selected duplicate punch." />
            <Button DockPanel.Dock="Right" Content="Close" Width="80" Height="28" IsCancel="True" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Save" Width="80" Height="28" Click="Save_Click" IsDefault="True" />
            <TextBlock VerticalAlignment="Center" Foreground="Gray" TextWrapping="Wrap"
                       Text="Add a missed punch, delete a duplicate, or switch its Type." />
        </DockPanel>
    </Grid>
</Window>
