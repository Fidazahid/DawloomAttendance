<UserControl x:Class="DawloomAttendance.Views.HolidaysWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="AddButton" Content="Add" Width="80" Height="30" Margin="0,0,8,0" Click="AddButton_Click" />
            <Button x:Name="DeleteButton" Content="Delete" Width="80" Height="30" Margin="0,0,8,0" Click="DeleteButton_Click" />
            <Button x:Name="SaveButton" Content="Save All" Width="90" Height="30" Margin="0,0,8,0" Click="SaveButton_Click" />
            <Button x:Name="RefreshButton" Content="Refresh" Width="80" Height="30" Click="RefreshButton_Click" />
        </StackPanel>

        <!-- Regular weekly days off (applied every week) -->
        <Border Grid.Row="1" BorderBrush="#FFCCCCCC" BorderThickness="1" Padding="8" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Regular weekly holidays:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" />
                <TextBlock Text="Apply to" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox x:Name="ScopeCombo" Width="120" Margin="0,0,12,0" VerticalAlignment="Center"
                          DisplayMemberPath="Label" SelectedValuePath="Month"
                          SelectionChanged="ScopeCombo_SelectionChanged" />
                <CheckBox x:Name="SunBox" Content="Sun" Margin="0,0,10,0" VerticalAlignment="Center" />
                <CheckBox x:Name="MonBox" Content="Mon" Margin="0,0,10,0" VerticalAlignment="Center" />
                <CheckBox x:Name="TueBox" Content="Tue" Margin="0,0,10,0" VerticalAlignment="Center" />
                <CheckBox x:Name="WedBox" Content="Wed" Margin="0,0,10,0" VerticalAlignment="Center" />
                <CheckBox x:Name="ThuBox" Content="Thu" Margin="0,0,10,0" VerticalAlignment="Center" />
                <CheckBox x:Name="FriBox" Content="Fri" Margin="0,0,10,0" VerticalAlignment="Center" />
                <CheckBox x:Name="SatBox" Content="Sat" Margin="0,0,10,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Date" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Date, StringFormat=yyyy-MM-dd}" Margin="4,2" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <DatePicker SelectedDate="{Binding Date, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="*" />
                <DataGridCheckBoxColumn Header="Recurring (yearly)" Binding="{Binding Recurring}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock VerticalAlignment="Center" Foreground="Gray"
                       Text="Recurring = repeats every year on the same month/day." />
        </StackPanel>
    </Grid>
</UserControl>
