<UserControl x:Class="DawloomAttendance.Views.AttendanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Date:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <DatePicker x:Name="DatePick" Width="140" Margin="0,0,8,0" />
            <Button x:Name="ComputeButton" Content="Compute" Width="100" Height="30" Click="ComputeButton_Click" Margin="0,0,8,0" />
            <Button x:Name="EditPunchesButton" Content="Edit Punches…" Width="120" Height="30" Click="EditPunchesButton_Click"
                    ToolTip="Review/correct the selected employee's punches for this date." />
            <TextBlock x:Name="Summary" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="Gray" />
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Enroll #" Binding="{Binding Enroll}" Width="70" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                <DataGridTextColumn Header="Check In" Binding="{Binding First}" Width="80" />
                <DataGridTextColumn Header="Check Out" Binding="{Binding Last}" Width="80" />
                <DataGridTextColumn Header="Late" Binding="{Binding Late}" Width="80" />
                <DataGridTextColumn Header="Early" Binding="{Binding Early}" Width="80" />
                <DataGridTextColumn Header="Worked" Binding="{Binding Worked}" Width="80" />
                <DataGridTextColumn x:Name="OtColumn" Header="OT" Binding="{Binding OT}" Width="70" />
                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</UserControl>
