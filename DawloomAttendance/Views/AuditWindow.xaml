<UserControl x:Class="DawloomAttendance.Views.AuditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,4,0" FontWeight="SemiBold" />
            <DatePicker x:Name="FromDate" Width="120" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,4,0" FontWeight="SemiBold" />
            <DatePicker x:Name="ToDate" Width="120" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock Text="User:" VerticalAlignment="Center" Margin="0,0,4,0" FontWeight="SemiBold" />
            <ComboBox x:Name="ActorBox" Width="160" VerticalAlignment="Center" Margin="0,0,12,0"
                      SelectionChanged="Filter_Changed" />
            <Button x:Name="RefreshButton" Content="Refresh" Width="80" Height="28" Click="RefreshButton_Click" />
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="When" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150" />
                <DataGridTextColumn Header="User" Binding="{Binding Actor}" Width="130" />
                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="160" />
                <DataGridTextColumn Header="Entity" Binding="{Binding Entity}" Width="110" />
                <DataGridTextColumn Header="Id" Binding="{Binding EntityId}" Width="60" />
                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" x:Name="Summary" Margin="0,8,0,0" Foreground="Gray" />
    </Grid>
</UserControl>
