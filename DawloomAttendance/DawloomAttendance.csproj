  <!-- ZkSdk: opt-in for strongly-typed ZKTeco interop + live event capture.
       Default false so the project builds on machines without the SDK.
       After registering the SDK (lib\zkteco\Register.bat as Admin), build with
       /p:ZkSdk=true  (or set <ZkSdk>true</ZkSdk> here / in your VS build).
       When true: the COMReference below generates Interop.zkemkeeper.dll and the
       ZK_TYPED constant compiles the OnAttTransactionEx live-capture code path. -->
  <!-- Auto-enable the strongly-typed SDK build whenever the ZKTeco interop assembly
       is committed at lib\zkteco\Interop.zkemkeeper.dll. That file is required to
       compile the ZK_TYPED code path (ReadAllLogs / ReadAllUsers / live capture), so
       its presence is exactly the condition under which the typed build can succeed.
       Without it, ZkSdk stays false and the project still builds on machines lacking
       the SDK (connect/ping work late-bound, but no data is read). An explicit
       /p:ZkSdk=true or =false on the command line still overrides this default.
       IMPORTANT: this is why the app reads device logs — with ZkSdk=false the read
       code is compiled out and the device returns 0 records despite connecting. -->
  <PropertyGroup>
    <ZkSdk Condition=" '$(ZkSdk)' == '' And Exists('$(MSBuildProjectDirectory)\lib\zkteco\Interop.zkemkeeper.dll') ">true</ZkSdk>
    <ZkSdk Condition=" '$(ZkSdk)' == '' ">false</ZkSdk>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(ZkSdk)' == 'true' ">
    <DefineConstants>$(DefineConstants);ZK_TYPED</DefineConstants>
  </PropertyGroup>
  <!-- Native SQLite engine deployment. The Stub.System.Data.SQLite.Core.NetFramework
       package copies SQLite.Interop.dll into bin\...\x86 and \x64 via its own
       CopySQLiteInteropFiles target (hooked into BuildDependsOn). Setting this to
       true ALSO adds those DLLs as Content items, so they are deployed through the
       standard CopyToOutputDirectory pipeline (and flow to publish/ClickOnce) — a
       second, independent copy path so the native engine can't silently go missing.
       Without the interop DLL, System.Data.SQLite throws "Unable to load DLL
       'SQLite.Interop.dll'" and the app runs but cannot persist any data. -->
  <PropertyGroup>
    <ContentSQLiteInteropFiles>true</ContentSQLiteInteropFiles>
  </PropertyGroup>
  <!-- Persistence: System.Data.SQLite.Core — the SQLite team's ADO.NET provider,
       purpose-built for .NET Framework. Chosen over Microsoft.Data.Sqlite because
       MDS 6.0's BundleInitializer NREs in ApplicationDataHelper on a non-packaged
       WPF app (it probes for a WinRT ApplicationData folder that doesn't exist).
       System.Data.SQLite.Core ships SQLite.Interop.dll per-architecture (x86/x64)
       and its x86 build is loaded by our x86 process. (Serilog file logging is a
       later step; device events are persisted to the SQLite DeviceLog table.) -->
  <ItemGroup>
    <!-- Excel export for reports. 0.95.4 is a net46-friendly line for .NET Framework. -->
    <PackageReference Include="ClosedXML" Version="0.95.4" />
    <!-- PDF export. PDFsharp/MigraDoc (MIT) chosen over iText7 (AGPL) for a commercial app.
         The GDI build targets .NET Framework. -->
    <PackageReference Include="PDFsharp-MigraDoc-GDI" Version="1.50.5147" />
    <!-- Rolling-file logging (second sink alongside the SQLite DeviceLog table). -->
    <PackageReference Include="Serilog" Version="2.12.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
    <!-- Reference the native-interop package DIRECTLY so its build targets run and
         copy SQLite.Interop.dll into bin\...\x86 and \x64. Under PackageReference,
         a transitive package's copy target does not run, so the native engine would
         otherwise be missing at runtime. -->
    <PackageReference Include="Stub.System.Data.SQLite.Core.NetFramework" Version="1.0.119" />
  </ItemGroup>
  <ItemGroup>
