  <!-- Fail-fast guard: verify the native SQLite engine actually reached the output.
       If the interop DLL is missing (e.g. a build that skipped NuGet restore, so the
       package's copy target never imported), the app would still launch but silently
       refuse to save data — logging only a quiet WARN. Turning that into a build
       error makes the failure impossible to miss. Checks the x86 subfolder (probed by
       our x86 process) and the app-dir fallback. Skipped when OutDir isn't set. -->
  <Target Name="VerifySQLiteInteropPresent" AfterTargets="Build"
          Condition=" '$(OutDir)' != '' And HasTrailingSlash('$(OutDir)') ">
    <Error Condition="!Exists('$(OutDir)x86\SQLite.Interop.dll') And !Exists('$(OutDir)SQLite.Interop.dll')"
           Text="Native SQLite engine 'SQLite.Interop.dll' is missing from the output ($(OutDir)). The app would run but be unable to save any data. This usually means the build skipped NuGet restore — run 'msbuild /t:Restore' (or build in Visual Studio / 'dotnet build') so the Stub.System.Data.SQLite.Core.NetFramework package can deploy the interop DLL, then rebuild." />
  </Target>
