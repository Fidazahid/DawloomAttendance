  <!-- Strongly-typed interop, only when ZkSdk=true. We reference a pre-generated
       Interop.zkemkeeper.dll (produced with tlbimp directly from the DLL file and
       committed under lib\zkteco) rather than a COMReference. This avoids the build
       needing the COM TypeLib registered — the team only needs the coclass
       registered to *run* (regsvr32 of zkemkeeper.dll). When ZkSdk is false,
       ZkDeviceClient falls back to late binding and live capture is compiled out. -->
  <ItemGroup Condition=" '$(ZkSdk)' == 'true' ">
    <Reference Include="Interop.zkemkeeper">
      <HintPath>lib\zkteco\Interop.zkemkeeper.dll</HintPath>
      <Private>True</Private>
      <EmbedInteropTypes>False</EmbedInteropTypes>
    </Reference>
    <!-- Native SDK DLLs must sit next to the exe at runtime (zkemkeeper loads them).
         Copy them into the output root (not a lib\zkteco subfolder). -->
    <None Include="lib\zkteco\*.dll" Exclude="lib\zkteco\Interop.zkemkeeper.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>
